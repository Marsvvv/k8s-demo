# ===================== 阶段 1：编译打包 =====================
# 使用与本地开发一致的 JDK 17 + Maven
FROM maven:3.9-eclipse-temurin-17 AS build
WORKDIR /build

# 先拷贝 pom（利用 Docker 层缓存：依赖不变时不用重复下载）
COPY pom.xml ./
COPY user-service/pom.xml user-service/pom.xml
# 再拷贝源码
COPY user-service/src user-service/src

RUN mvn -q -f user-service/pom.xml package -DskipTests

# ===================== 阶段 2：运行 =====================
# 运行镜像只带 JRE，无 Maven/JDK 编译器，体积小、攻击面小
FROM eclipse-temurin:17-jre
WORKDIR /app
COPY --from=build /build/user-service/target/user-service-*.jar app.jar

EXPOSE 8080
ENTRYPOINT ["java", "-jar", "/app/app.jar"]
